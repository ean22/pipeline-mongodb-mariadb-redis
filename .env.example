# Exemplo de configuração de variáveis de ambiente (.env)
# Renomeie para .env e preencha com as credenciais reais.

# MariaDB (Séries temporais e Agregações)
MARIADB_HOST=35.226.64.52
MARIADB_PORT=3306
MARIADB_USER=fatec_app
MARIADB_PASSWORD=sua_senha_aqui
MARIADB_DATABASE=fatec_iot
TABLE_PREFIX=eduardo_

# MongoDB (Leitura dos pacotes brutos da rede mesh)
MONGODB_HOST=35.226.64.52
MONGODB_PORT=27017
MONGODB_USER=root
MONGODB_PASSWORD=sua_senha_aqui
MONGODB_DATABASE=iot
MONGODB_COLLECTION=sensores
